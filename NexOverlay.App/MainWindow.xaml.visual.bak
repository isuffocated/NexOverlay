<Window x:Class="NexOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0">

    <Grid x:Name="OverlaySurface">

        <!-- fullscreen veil -->
        <Grid.Background>
            <RadialGradientBrush
                Center="0.5,0.46"
                GradientOrigin="0.5,0.46"
                RadiusX="0.95"
                RadiusY="0.95">

                <GradientStop Color="#C40A0D12" Offset="0"/>
                <GradientStop Color="#D30A0D12" Offset="0.58"/>
                <GradientStop Color="#E5090B0F" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- subtle central atmosphere -->
        <Border
            x:Name="AmbientGlow"
            Width="960"
            Height="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#01000000"
            Opacity="0">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="90"
                    ShadowDepth="0"
                    Opacity="0.14"
                    Color="#477BBFFF"/>
            </Border.Effect>
        </Border>

        <!-- TOP GATEWAY -->
        <Grid
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,52,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <Border
                Height="1"
                Background="#42FFFFFF"
                VerticalAlignment="Center"/>

            <Grid Grid.Column="1">
                <Border
                    Width="10"
                    Height="10"
                    BorderBrush="#D7E6F8"
                    BorderThickness="1.4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Border
                Grid.Column="2"
                Height="1"
                Background="#42FFFFFF"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN COMPOSITION -->
        <Border
            x:Name="MainCore"
            Width="1720"
            Height="900"
            MaxWidth="1720"
            MaxHeight="900"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5"
            Opacity="0">

            <Border.RenderTransform>
                <ScaleTransform
                    x:Name="CoreScale"
                    ScaleX="0.16"
                    ScaleY="0.16"/>
            </Border.RenderTransform>

            <Grid
                x:Name="MainContent"
                Margin="70"
                Opacity="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: RECENT -->
                <Grid
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Height="390">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="RECENT"
                            Foreground="#72FFFFFF"
                            FontSize="10"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Margin="0,7,0,0"
                            Text="Your last activity"
                            Foreground="#38FFFFFF"
                            FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">

                        <Grid Height="58">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="2"
                                Height="28"
                                CornerRadius="1"
                                Background="#75A9CFFF"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="payment-template"
                                    Foreground="#BFFFFFFF"
                                    FontSize="12"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="snippet  ·  3m"
                                    Foreground="#42FFFFFF"
                                    FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF"/>

                        <Grid Height="58">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="2"
                                Height="28"
                                CornerRadius="1"
                                Background="#68B8F0E5"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="order-info.md"
                                    Foreground="#AFFFFFFF"
                                    FontSize="12"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="note  ·  18m"
                                    Foreground="#42FFFFFF"
                                    FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF"/>

                        <Grid Height="58">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="2"
                                Height="28"
                                CornerRadius="1"
                                Background="#5FFFC3DB"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="screenshot-1832"
                                    Foreground="#AFFFFFFF"
                                    FontSize="12"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="image  ·  1h"
                                    Foreground="#42FFFFFF"
                                    FontSize="10"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Grid>

                <!-- CENTER -->
                <Grid
                    Grid.Column="2"
                    Width="900"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- tiny identity -->
                    <StackPanel
                        HorizontalAlignment="Center">

                        <Border
                            Width="26"
                            Height="26"
                            BorderBrush="#90DDEBFA"
                            BorderThickness="1.3"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Border.RenderTransform>
                        </Border>

                        <TextBlock
                            Margin="0,15,0,0"
                            Text="NEX"
                            Foreground="#36FFFFFF"
                            FontSize="9"
                            HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- command core -->
                    <Border
                        Grid.Row="2"
                        Height="106"
                        CornerRadius="34"
                        Background="#E80A0D12"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="34"
                                ShadowDepth="0"
                                Opacity="0.18"
                                Color="#517EB7F5"/>
                        </Border.Effect>

                        <Grid Margin="18,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="54"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="46"
                                Height="46"
                                CornerRadius="15"
                                Background="#11182122"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center">

                                <Border
                                    Width="12"
                                    Height="12"
                                    BorderBrush="#DCE9FA"
                                    BorderThickness="1.4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">

                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Height="34"
                                Background="#18FFFFFF"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="Search anything..."
                                Foreground="#7AFFFFFF"
                                FontSize="18"
                                VerticalAlignment="Center"/>

                            <Grid
                                Grid.Column="4"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <Ellipse
                                    Width="14"
                                    Height="14"
                                    Stroke="#B8C8DB"
                                    StrokeThickness="1.6"
                                    Margin="-5,-5,0,0"/>

                                <Border
                                    Width="8"
                                    Height="1.5"
                                    Background="#B8C8DB"
                                    Margin="10,10,0,0"
                                    RenderTransformOrigin="0.5,0.5">

                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- modules -->
                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NOTES -->
                        <Border
                            x:Name="NotesCard"
                            Grid.Column="0"
                            Height="70"
                            CornerRadius="18"
                            Background="#12FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Notes"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="◫"
                                    Foreground="#AFCFFF"
                                    FontSize="13"/>

                                <TextBlock
                                    Margin="9,0,0,0"
                                    Text="NOTES"
                                    Foreground="#8FFFFFFF"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- SNIPPETS -->
                        <Border
                            x:Name="SnippetsCard"
                            Grid.Column="2"
                            Height="70"
                            CornerRadius="18"
                            Background="#12FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Snippets"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="⌁"
                                    Foreground="#C3B5FF"
                                    FontSize="14"/>

                                <TextBlock
                                    Margin="9,0,0,0"
                                    Text="SNIPS"
                                    Foreground="#8FFFFFFF"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- FILES -->
                        <Border
                            x:Name="FilesCard"
                            Grid.Column="4"
                            Height="70"
                            CornerRadius="18"
                            Background="#12FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Files"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="▱"
                                    Foreground="#A7F0E7"
                                    FontSize="13"/>

                                <TextBlock
                                    Margin="9,0,0,0"
                                    Text="FILES"
                                    Foreground="#8FFFFFFF"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- CLIPS -->
                        <Border
                            x:Name="ClipsCard"
                            Grid.Column="6"
                            Height="70"
                            CornerRadius="18"
                            Background="#12FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Clips"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="◈"
                                    Foreground="#FFC3DB"
                                    FontSize="12"/>

                                <TextBlock
                                    Margin="9,0,0,0"
                                    Text="CLIPS"
                                    Foreground="#8FFFFFFF"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- contextual footer -->
                    <StackPanel
                        Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Ellipse
                            Width="4"
                            Height="4"
                            Fill="#5FB5D5FF"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Margin="9,0,0,0"
                            Text="READY"
                            Foreground="#38FFFFFF"
                            FontSize="9"/>
                    </StackPanel>
                </Grid>

                <!-- RIGHT: WORKSPACE -->
                <Grid
                    Grid.Column="4"
                    Height="390"
                    VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="WORKSPACE"
                            HorizontalAlignment="Right"
                            Foreground="#72FFFFFF"
                            FontSize="10"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Margin="0,7,0,0"
                            Text="@default"
                            HorizontalAlignment="Right"
                            Foreground="#38FFFFFF"
                            FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">

                        <Grid Height="64">
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="12"
                                    HorizontalAlignment="Right"
                                    Foreground="#CFFFFFFF"
                                    FontSize="20"
                                    FontWeight="Light"/>

                                <TextBlock
                                    Margin="0,3,0,0"
                                    Text="NOTES"
                                    Foreground="#42FFFFFF"
                                    FontSize="9"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF"/>

                        <Grid Height="64">
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="24"
                                    HorizontalAlignment="Right"
                                    Foreground="#CFFFFFFF"
                                    FontSize="20"
                                    FontWeight="Light"/>

                                <TextBlock
                                    Margin="0,3,0,0"
                                    Text="SNIPPETS"
                                    Foreground="#42FFFFFF"
                                    FontSize="9"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#0FFFFFFF"/>

                        <Grid Height="64">
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="17"
                                    HorizontalAlignment="Right"
                                    Foreground="#CFFFFFFF"
                                    FontSize="20"
                                    FontWeight="Light"/>

                                <TextBlock
                                    Margin="0,3,0,0"
                                    Text="FILES"
                                    Foreground="#42FFFFFF"
                                    FontSize="9"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>