<Window x:Class="NexOverlay.App.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="334"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0">

    <Grid
        x:Name="Root"
        Margin="28"
        RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"
                                ScaleX="0.96"
                                ScaleY="0.96"/>
                <TranslateTransform x:Name="RootTranslate"
                                    Y="12"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border
            CornerRadius="26"
            Background="#E811151C"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="38"
                    ShadowDepth="8"
                    Direction="270"
                    Opacity="0.50"
                    Color="#D0000000"/>
            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock
                        Text="WORKSPACE"
                        Foreground="#E4FFFFFF"
                        FontSize="11"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="@default"
                        Margin="0,5,0,0"
                        Foreground="#66FFFFFF"
                        FontSize="10"/>
                </StackPanel>

                <UniformGrid
                    Grid.Row="2"
                    Rows="3"
                    Columns="1">

                    <Border
                        Margin="0,0,0,9"
                        CornerRadius="14"
                        Background="#12FFFFFF">
                        <Grid Margin="16,0">
                            <TextBlock Text="NOTES"
                                       Foreground="#6FFFFFFF"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="12"
                                       Foreground="#F0FFFFFF"
                                       FontSize="22"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,0,0,9"
                        CornerRadius="14"
                        Background="#12FFFFFF">
                        <Grid Margin="16,0">
                            <TextBlock Text="SNIPPETS"
                                       Foreground="#6FFFFFFF"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="24"
                                       Foreground="#F0FFFFFF"
                                       FontSize="22"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border
                        CornerRadius="14"
                        Background="#12FFFFFF">
                        <Grid Margin="16,0">
                            <TextBlock Text="FILES"
                                       Foreground="#6FFFFFFF"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="17"
                                       Foreground="#F0FFFFFF"
                                       FontSize="22"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
