<Window x:Class="NexOverlay.App.RecentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="334"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0">

    <Grid
        x:Name="Root"
        Margin="28"
        RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"
                                ScaleX="0.96"
                                ScaleY="0.96"/>
                <TranslateTransform x:Name="RootTranslate"
                                    Y="12"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border
            CornerRadius="26"
            Background="#E811151C"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="38"
                    ShadowDepth="8"
                    Direction="270"
                    Opacity="0.50"
                    Color="#D0000000"/>
            </Border.Effect>

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock
                        Text="RECENT"
                        Foreground="#E4FFFFFF"
                        FontSize="11"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Last activity"
                        Margin="0,5,0,0"
                        Foreground="#66FFFFFF"
                        FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Row="2">

                    <Border
                        Height="62"
                        CornerRadius="14"
                        Background="#12FFFFFF"
                        Margin="0,0,0,9">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="2"
                                    Height="28"
                                    CornerRadius="1"
                                    Background="#91A9CFFF"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="payment-template"
                                           Foreground="#E8FFFFFF"
                                           FontSize="12"/>
                                <TextBlock Text="snippet В· 3m"
                                           Margin="0,4,0,0"
                                           Foreground="#58FFFFFF"
                                           FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Height="62"
                        CornerRadius="14"
                        Background="#12FFFFFF"
                        Margin="0,0,0,9">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="2"
                                    Height="28"
                                    CornerRadius="1"
                                    Background="#84A7F0E7"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="order-info.md"
                                           Foreground="#E8FFFFFF"
                                           FontSize="12"/>
                                <TextBlock Text="note В· 18m"
                                           Margin="0,4,0,0"
                                           Foreground="#58FFFFFF"
                                           FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Height="62"
                        CornerRadius="14"
                        Background="#12FFFFFF">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="2"
                                    Height="28"
                                    CornerRadius="1"
                                    Background="#80FFC3DB"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="screenshot-1832"
                                           Foreground="#E8FFFFFF"
                                           FontSize="12"/>
                                <TextBlock Text="image В· 1h"
                                           Margin="0,4,0,0"
                                           Foreground="#58FFFFFF"
                                           FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
