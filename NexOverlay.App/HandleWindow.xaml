<Window x:Class="NexOverlay.App.HandleWindow"
        FontFamily="/NexOverlay.App;component/Assets/Fonts/#Copperplate"
        FontWeight="Normal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="330"
        Height="58"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">

    <Grid
        x:Name="Root"
        Background="Transparent"
        MouseEnter="Root_OnMouseEnter">

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="118"/>
            </Grid.ColumnDefinitions>

            <Border
                x:Name="LeftLine"
                Height="1"
                Background="#5CFFFFFF"
                VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        ShadowDepth="0"
                        Opacity="0.35"
                        Color="#75A9FF"/>
                </Border.Effect>
            </Border>

            <Border
                x:Name="HandleBorder"
                Grid.Column="1"
                Width="15"
                Height="15"
                Background="#F20D131B"
                BorderBrush="#DDEBFF"
                BorderThickness="1.2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <RotateTransform Angle="45"/>
                </Border.RenderTransform>

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="14"
                        ShadowDepth="0"
                        Opacity="0.55"
                        Color="#76ADFF"/>
                </Border.Effect>

                <Border
                    x:Name="HandleDot"
                    Width="4"
                    Height="4"
                    CornerRadius="2"
                    Background="#DDEBFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <Border
                x:Name="HandleLine"
                Grid.Column="2"
                Height="1"
                Background="#5CFFFFFF"
                VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        ShadowDepth="0"
                        Opacity="0.35"
                        Color="#75A9FF"/>
                </Border.Effect>
            </Border>

        </Grid>
    </Grid>
</Window>
