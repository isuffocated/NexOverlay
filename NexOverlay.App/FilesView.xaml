<UserControl x:Class="NexOverlay.App.FilesView"
             FontFamily="/NexOverlay.App;component/Assets/Fonts/#Copperplate"
             FontWeight="Normal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="Background" Value="#13FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#20FFFFFF"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#627EB7F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="FileRowStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#13171D25"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
    </UserControl.Resources>

    <Border Margin="28"
            CornerRadius="28"
            Background="#F011151C"
            BorderBrush="#42FFFFFF"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="42"
                              ShadowDepth="10"
                              Direction="270"
                              Opacity="0.54"
                              Color="#D0000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Width="40"
                        Height="40"
                        Style="{StaticResource IconButtonStyle}"
                        Click="BackButton_OnClick"
                        ToolTip="Back">
                    <svgc:SvgViewbox Width="17"
                                     Height="17"
                                     Source="/Assets/Icons/arrow-left.svg"/>
                </Button>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="FILES"
                               Foreground="#F2FFFFFF"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText"
                               Text="0 linked"
                               Margin="0,4,0,0"
                               Foreground="#62FFFFFF"
                               FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="40"
                        Height="40"
                        Style="{StaticResource IconButtonStyle}"
                        Click="AddButton_OnClick"
                        ToolTip="Add file">
                    <svgc:SvgViewbox Width="17"
                                     Height="17"
                                     Source="/Assets/Icons/plus.svg"/>
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Height="50"
                    CornerRadius="16"
                    Background="#11161C24"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">
                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <svgc:SvgViewbox Width="15"
                                     Height="15"
                                     Source="/Assets/Icons/search.svg"
                                     VerticalAlignment="Center"/>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Margin="11,0,0,0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E5FFFFFF"
                             CaretBrush="White"
                             FontSize="13"
                             TextChanged="SearchBox_OnTextChanged"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="FileList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FileRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="10"
                                            Background="#13FFFFFF"
                                            BorderBrush="#24FFFFFF"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <svgc:SvgViewbox Width="16"
                                                         Height="16"
                                                         Source="/Assets/Icons/folder.svg"/>
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#EDFFFFFF"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Margin="0,5,0,0"
                                                   Foreground="#58FFFFFF"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="470"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Tag="{Binding}"
                                                Margin="0,0,7,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="OpenButton_OnClick"
                                                ToolTip="Open">
                                            <svgc:SvgViewbox Width="14"
                                                             Height="14"
                                                             Source="/Assets/Icons/folder.svg"/>
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Margin="0,0,7,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="RevealButton_OnClick"
                                                ToolTip="Show in Explorer">
                                            <svgc:SvgViewbox Width="14"
                                                             Height="14"
                                                             Source="/Assets/Icons/external-link.svg"/>
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DeleteButton_OnClick"
                                                ToolTip="Remove from workspace">
                                            <svgc:SvgViewbox Width="14"
                                                             Height="14"
                                                             Source="/Assets/Icons/trash-2.svg"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText"
                       Grid.Row="4"
                       Text="No files linked yet."
                       Foreground="#5CFFFFFF"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText"
                       Grid.Row="5"
                       Margin="2,10,0,0"
                       Foreground="#62FFFFFF"
                       FontSize="13"/>
        </Grid>
    </Border>
</UserControl>