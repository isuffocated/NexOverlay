<Window x:Class="NexOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0">

    <Grid x:Name="OverlaySurface" Background="#01000000">

        <!-- dark fullscreen veil -->
        <Border Background="#CE090B10"/>

        <!-- extra vignette -->
        <Border>
            <Border.Background>
                <RadialGradientBrush
                    Center="0.5,0.46"
                    GradientOrigin="0.5,0.46"
                    RadiusX="0.92"
                    RadiusY="0.92">
                    <GradientStop Color="#400F1C30" Offset="0"/>
                    <GradientStop Color="#150A0D12" Offset="0.45"/>
                    <GradientStop Color="#A8090B10" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- central glow -->
        <Border
            x:Name="AmbientGlow"
            Width="1120"
            Height="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            Opacity="0">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="135"
                    ShadowDepth="0"
                    Opacity="0.24"
                    Color="#4B7EC5FF"/>
            </Border.Effect>
        </Border>

        <!-- top gateway -->
        <Grid
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,42,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Border
                Height="1"
                Background="#4CFFFFFF"
                VerticalAlignment="Center"/>

            <Border
                Grid.Column="1"
                Width="10"
                Height="10"
                BorderBrush="#E2EEFF"
                BorderThickness="1.2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <RotateTransform Angle="45"/>
                </Border.RenderTransform>
            </Border>

            <Border
                Grid.Column="2"
                Height="1"
                Background="#4CFFFFFF"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- main responsive composition -->
        <Border
            x:Name="MainCore"
            Width="1760"
            Height="900"
            MaxWidth="1760"
            MaxHeight="900"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5"
            Opacity="0">

            <Border.RenderTransform>
                <ScaleTransform
                    x:Name="CoreScale"
                    ScaleX="0.16"
                    ScaleY="0.16"/>
            </Border.RenderTransform>

            <Grid
                x:Name="MainContent"
                Margin="78"
                Opacity="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT / RECENT -->
                <Grid
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Height="430">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="RECENT"
                            Foreground="#86FFFFFF"
                            FontSize="12"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Margin="0,7,0,0"
                            Text="Your last activity"
                            Foreground="#44FFFFFF"
                            FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">

                        <Grid Height="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="2"
                                Height="32"
                                CornerRadius="1"
                                Background="#7AA9CFFF"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="payment-template"
                                    Foreground="#D6FFFFFF"
                                    FontSize="14"/>
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="snippet  ·  3m"
                                    Foreground="#44FFFFFF"
                                    FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#10FFFFFF"/>

                        <Grid Height="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="2"
                                Height="32"
                                CornerRadius="1"
                                Background="#73B8F0E5"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="order-info.md"
                                    Foreground="#D6FFFFFF"
                                    FontSize="14"/>
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="note  ·  18m"
                                    Foreground="#44FFFFFF"
                                    FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#10FFFFFF"/>

                        <Grid Height="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="2"
                                Height="32"
                                CornerRadius="1"
                                Background="#6CFFC3DB"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="screenshot-1832"
                                    Foreground="#D6FFFFFF"
                                    FontSize="14"/>
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="image  ·  1h"
                                    Foreground="#44FFFFFF"
                                    FontSize="10"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Grid>

                <!-- CENTER -->
                <Grid
                    Grid.Column="2"
                    Width="920"
                    MaxWidth="920"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- identity -->
                    <Border
                        Width="26"
                        Height="26"
                        BorderBrush="#A4DDEBFA"
                        BorderThickness="1.3"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- command core glow -->
                    <Border
                        Grid.Row="2"
                        Height="116"
                        CornerRadius="36"
                        Background="#01000000">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="42"
                                ShadowDepth="0"
                                Opacity="0.28"
                                Color="#5A8CD1FF"/>
                        </Border.Effect>
                    </Border>

                    <!-- command core -->
                    <Border
                        Grid.Row="2"
                        Height="108"
                        CornerRadius="34"
                        Background="#F0090C11"
                        BorderBrush="#32FFFFFF"
                        BorderThickness="1">

                        <Grid>

                            <Border
                                Height="1"
                                Margin="34,1,34,0"
                                VerticalAlignment="Top"
                                Background="#32FFFFFF"/>

                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="48"
                                    Height="48"
                                    CornerRadius="16"
                                    Background="#12182122"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">

                                    <Border
                                        Width="12"
                                        Height="12"
                                        BorderBrush="#DCE9FA"
                                        BorderThickness="1.35"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">

                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Height="34"
                                    Background="#16FFFFFF"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="Search anything..."
                                    Foreground="#8BFFFFFF"
                                    FontSize="18"
                                    VerticalAlignment="Center"/>

                                <Grid
                                    Grid.Column="4"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                                    <Ellipse
                                        Width="14"
                                        Height="14"
                                        Stroke="#C7D6E8"
                                        StrokeThickness="1.7"
                                        Margin="-5,-5,0,0"/>

                                    <Border
                                        Width="8"
                                        Height="1.7"
                                        Background="#C7D6E8"
                                        Margin="10,10,0,0"
                                        RenderTransformOrigin="0.5,0.5">

                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- modules -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="NotesCard"
                            Grid.Column="0"
                            Height="72"
                            CornerRadius="20"
                            Background="#10FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Notes"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Text="◫" Foreground="#AFCFFF" FontSize="13"/>
                                <TextBlock Margin="10,0,0,0" Text="NOTES" Foreground="#96FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="SnippetsCard"
                            Grid.Column="2"
                            Height="72"
                            CornerRadius="20"
                            Background="#10FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Snippets"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Text="⌁" Foreground="#C3B5FF" FontSize="14"/>
                                <TextBlock Margin="10,0,0,0" Text="SNIPS" Foreground="#96FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="FilesCard"
                            Grid.Column="4"
                            Height="72"
                            CornerRadius="20"
                            Background="#10FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Files"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Text="▱" Foreground="#A7F0E7" FontSize="13"/>
                                <TextBlock Margin="10,0,0,0" Text="FILES" Foreground="#96FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="ClipsCard"
                            Grid.Column="6"
                            Height="72"
                            CornerRadius="20"
                            Background="#10FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Tag="Clips"
                            MouseEnter="ModuleCard_OnMouseEnter"
                            MouseLeave="ModuleCard_OnMouseLeave"
                            MouseLeftButtonUp="ModuleCard_OnMouseLeftButtonUp"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Text="◈" Foreground="#FFC3DB" FontSize="12"/>
                                <TextBlock Margin="10,0,0,0" Text="CLIPS" Foreground="#96FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- footer -->
                    <StackPanel
                        Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="#6CB5D5FF" VerticalAlignment="Center"/>
                        <TextBlock Margin="9,0,0,0" Text="READY" Foreground="#40FFFFFF" FontSize="9"/>
                    </StackPanel>
                </Grid>

                <!-- RIGHT / WORKSPACE -->
                <Grid
                    Grid.Column="4"
                    Height="430"
                    VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="WORKSPACE"
                            HorizontalAlignment="Right"
                            Foreground="#86FFFFFF"
                            FontSize="12"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Margin="0,7,0,0"
                            Text="@default"
                            HorizontalAlignment="Right"
                            Foreground="#44FFFFFF"
                            FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">

                        <Grid Height="74">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="12" HorizontalAlignment="Right" Foreground="#D6FFFFFF" FontSize="24" FontWeight="Light"/>
                                <TextBlock Margin="0,4,0,0" Text="NOTES" Foreground="#44FFFFFF" FontSize="9"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#10FFFFFF"/>

                        <Grid Height="74">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="24" HorizontalAlignment="Right" Foreground="#D6FFFFFF" FontSize="24" FontWeight="Light"/>
                                <TextBlock Margin="0,4,0,0" Text="SNIPPETS" Foreground="#44FFFFFF" FontSize="9"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#10FFFFFF"/>

                        <Grid Height="74">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="17" HorizontalAlignment="Right" Foreground="#D6FFFFFF" FontSize="24" FontWeight="Light"/>
                                <TextBlock Margin="0,4,0,0" Text="FILES" Foreground="#44FFFFFF" FontSize="9"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
