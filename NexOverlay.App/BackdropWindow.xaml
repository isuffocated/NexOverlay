<Window x:Class="NexOverlay.App.BackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#FF06080C"
        Opacity="0">

    <Grid ClipToBounds="True">

        <Border Margin="-18">
            <Image
                x:Name="DesktopImage"
                Stretch="Fill"
                RenderOptions.BitmapScalingMode="HighQuality">

                <Image.Effect>
                    <BlurEffect Radius="15"
                                KernelType="Gaussian"
                                RenderingBias="Performance"/>
                </Image.Effect>
            </Image>
        </Border>

        <Border Background="#8206080C"/>

        <Border>
            <Border.Background>
                <RadialGradientBrush
                    Center="0.5,0.46"
                    GradientOrigin="0.5,0.46"
                    RadiusX="0.95"
                    RadiusY="0.95">
                    <GradientStop Color="#081D3355" Offset="0"/>
                    <GradientStop Color="#10090C11" Offset="0.50"/>
                    <GradientStop Color="#3F040609" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

    </Grid>
</Window>