<UserControl x:Class="NexOverlay.App.SnippetsView"
        FontFamily="/NexOverlay.App;component/Assets/Fonts/#Copperplate"
        FontWeight="Normal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">

    <UserControl.Resources>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="Background" Value="#13FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#20FFFFFF"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#627EB7F5"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="FieldStyle"
               TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="#11161C24"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SnippetRowStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#13171D25"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>

    </UserControl.Resources>

    <Border
        Margin="28"
        CornerRadius="28"
        Background="#F011151C"
        BorderBrush="#42FFFFFF"
        BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="42"
                ShadowDepth="10"
                Direction="270"
                Opacity="0.54"
                Color="#D0000000"/>
        </Border.Effect>

        <Grid Margin="24">

            <Grid x:Name="ListPanel">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="40"
                        Height="40"
                        Style="{StaticResource IconButtonStyle}"
                        Click="BackButton_OnClick"
                        ToolTip="Back">
                        <svgc:SvgViewbox
                            Width="17"
                            Height="17"
                            Source="/Assets/Icons/arrow-left.svg"/>
                    </Button>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="SNIPPETS"
                            Foreground="#F2FFFFFF"
                            FontSize="19"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="CountText"
                            Text="0 saved"
                            Margin="0,4,0,0"
                            Foreground="#62FFFFFF"
                            FontSize="13"/>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Style="{StaticResource IconButtonStyle}"
                        Click="NewButton_OnClick"
                        ToolTip="New snippet">
                        <svgc:SvgViewbox
                            Width="17"
                            Height="17"
                            Source="/Assets/Icons/plus.svg"/>
                    </Button>
                </Grid>

                <Border
                    Grid.Row="2"
                    Height="50"
                    CornerRadius="16"
                    Background="#11161C24"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">

                    <Grid Margin="15,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <svgc:SvgViewbox
                            Width="15"
                            Height="15"
                            Source="/Assets/Icons/search.svg"
                            VerticalAlignment="Center"/>

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Margin="11,0,0,0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#E5FFFFFF"
                            CaretBrush="White"
                            FontSize="13"
                            TextChanged="SearchBox_OnTextChanged"/>
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="4"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="SnippetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SnippetRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Title}"
                                                Foreground="#EDFFFFFF"
                                                FontSize="13"
                                                FontWeight="SemiBold"/>

                                            <TextBlock
                                                Text="{Binding Category}"
                                                Margin="0,4,0,0"
                                                Foreground="#58FFFFFF"
                                                FontSize="13"/>

                                            <TextBlock
                                                Text="{Binding Content}"
                                                Margin="0,9,0,0"
                                                Foreground="#8DFFFFFF"
                                                FontSize="13"
                                                TextTrimming="CharacterEllipsis"
                                                MaxWidth="500"/>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                            <Button
                                                Tag="{Binding}"
                                                Margin="0,0,7,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="EditButton_OnClick"
                                                ToolTip="Edit">
                                                <svgc:SvgViewbox
                                                    Width="14"
                                                    Height="14"
                                                    Source="/Assets/Icons/pencil.svg"/>
                                            </Button>

                                            <Button
                                                Tag="{Binding}"
                                                Margin="0,0,7,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="CopyButton_OnClick"
                                                ToolTip="Copy">
                                                <svgc:SvgViewbox
                                                    Width="14"
                                                    Height="14"
                                                    Source="/Assets/Icons/copy.svg"/>
                                            </Button>

                                            <Button
                                                Tag="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DeleteButton_OnClick"
                                                ToolTip="Delete">
                                                <svgc:SvgViewbox
                                                    Width="14"
                                                    Height="14"
                                                    Source="/Assets/Icons/trash-2.svg"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="4"
                    Text="No snippets yet."
                    Foreground="#5CFFFFFF"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"/>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="5"
                    Margin="2,10,0,0"
                    Foreground="#62FFFFFF"
                    FontSize="13"/>
            </Grid>

            <Grid
                x:Name="EditorPanel"
                Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            x:Name="EditorTitle"
                            Text="NEW SNIPPET"
                            Foreground="#F2FFFFFF"
                            FontSize="19"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Stored locally on this PC"
                            Margin="0,4,0,0"
                            Foreground="#62FFFFFF"
                            FontSize="13"/>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CancelEditorButton_OnClick"
                        ToolTip="Close editor">
                        <svgc:SvgViewbox
                            Width="17"
                            Height="17"
                            Source="/Assets/Icons/x.svg"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock
                        Text="TITLE"
                        Margin="2,0,0,6"
                        Foreground="#66FFFFFF"
                        FontSize="13"/>

                    <TextBox
                        x:Name="TitleBox"
                        Style="{StaticResource FieldStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock
                        Text="CATEGORY"
                        Margin="2,0,0,6"
                        Foreground="#66FFFFFF"
                        FontSize="13"/>

                    <TextBox
                        x:Name="CategoryBox"
                        Style="{StaticResource FieldStyle}"/>
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="CONTENT"
                        Margin="2,0,0,0"
                        Foreground="#66FFFFFF"
                        FontSize="13"/>

                    <TextBox
                        x:Name="ContentBox"
                        Grid.Row="2"
                        Style="{StaticResource FieldStyle}"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        VerticalContentAlignment="Top"/>
                </Grid>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="EditorErrorText"
                        Foreground="#E88CA0"
                        FontSize="13"
                        VerticalAlignment="Center"/>

                    <Button
                        Grid.Column="1"
                        Content="SAVE"
                        MinWidth="96"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveButton_OnClick"
                        FontSize="13"
                        FontWeight="SemiBold"/>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</UserControl>